	"authors": [
		"fl"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/gungnir/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gungnir.GungnirMod"
		],
		"client": [
			"com.gungnir.client.GungnirClient"
		]
	},
	"mixins": [
		"gungnir.mixins.json",
		{
			"config": "gungnir.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.8",
		"minecraft": "~1.20.2",
